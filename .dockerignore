# Rust build artifacts — recreated fresh inside the builder stage.
target/
**/target/

# Git internals and history.
.git/
.gitignore
.gitmodules
.gitattributes

# Reference material — not needed at runtime.
ref/

# Editor/IDE state.
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# CI/CD and local tooling.
.github/

# dist/ holds packaging artifacts (PKGBUILD, systemd unit). None are
# consumed by the container image — CI writes the release binaries to
# dist/ via the build context, and the Dockerfile COPYs those by name.
# Keep the directory ignored so stray packaging files don't leak in.
dist/*

# Docs — not shipped in the image.
docs/
README.md
LICENSE.tmp

# Our own Docker files (no inception).
Dockerfile
.dockerignore
docker-compose.yml
