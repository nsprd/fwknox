# SPDX-License-Identifier: AGPL-3.0-or-later
#
# fwknox daemon example configuration.
#
# Copy this file to /etc/fwknox/fwknoxd.toml and edit for your environment.
# The master key below is a fixed all-0x11 placeholder and MUST be
# replaced before the daemon is put into production. The all-zero
# key is explicitly rejected by validate() so a missed edit is
# caught at startup. Generate a real key with:
#
#     head -c 32 /dev/urandom | base64
#
# Then paste the output into the `master_key_base64` field of every access
# stanza that should share it.

[daemon]
listen_addr         = "0.0.0.0"
listen_port         = 62201
firewall_backend    = "nftables"
run_user            = "fwknox"
run_group           = "fwknox"
max_spa_packet_age  = "120s"
flush_rules_at_init = true
flush_rules_at_exit = true
default_fw_timeout  = "30s"
max_fw_timeout      = "5m"
enable_systemd      = true
enable_sandbox      = true
landlock_enabled    = false
enable_privsep      = true

[replay]
cache_path = "/var/lib/fwknox/replay.cache"
max_age    = "24h"

# ----------------------------------------------------------------------
# [rate_limit] — per-source UDP packet rate limiter
#
# Protects the daemon from packet-flood denial of service by enforcing
# token-bucket rate limits in the capture path, before packets reach
# the crypto pipeline. Two tiers:
#
#   1. A small LRU of "hot sources" gets exact per-source accounting.
#   2. All other traffic shares a single global fallback bucket.
#
# Sources earn their way into the hot LRU by successfully consuming
# `promotion_threshold` tokens from the global bucket (rejected packets
# do not count). This design prevents an attacker from forcing
# promotion via sustained flood volume.
# ----------------------------------------------------------------------
[rate_limit]

# Master switch. Set to false to disable rate limiting entirely.
enabled = true

# Per-source token bucket (applies to sources promoted into exact
# tracking). Defaults chosen so legitimate clients never see drops:
# one SPA session is ~1 packet, and 10/sec is 100x above any realistic
# legitimate rate.
per_source_rate_per_sec = 10
per_source_burst        = 20

# Maximum number of exact-tracked sources. LRU-evicted when full.
# Larger values give more precise accounting for active deployments;
# smaller values reduce memory footprint but evict faster under load.
tracked_sources_capacity = 1024

# Global fallback bucket. Sized so a sustained flood can push at most
# ~500 pps through the crypto worker — well below the packet rate at
# which HMAC verification becomes a CPU bottleneck.
global_rate_per_sec = 500
global_burst        = 1000

# Number of successful global-bucket consumptions before a source is
# promoted into exact tracking. Rejected packets do not contribute.
promotion_threshold = 5

# IPv6 source addresses are masked to this prefix length before keying.
# /64 is the IETF-standard end-site allocation boundary. Use /48 in
# deployments where corporate IPv6 allocations dominate the traffic;
# use /128 (no masking) only if you understand the exhaustion risk.
ipv6_prefix_len = 64

# Example access stanza: opens SSH (22/tcp) from whichever IP sent the SPA
# packet, for the duration requested by the packet (capped by
# max_fw_timeout above).
#
# The `source` and `open_ports` fields are TOML arrays even when there is
# only a single entry.
#
# Replace master_key_base64 with your own 32-byte base64 key before use.
# The fixed-pattern all-0x11 key below is for parse testing only and is
# NOT secure. validate() rejects the all-zero key specifically so an
# operator who forgot to edit this file gets a loud error at startup.
[[access]]
name              = "ssh-from-anywhere"
source            = ["any"]
open_ports        = ["tcp/22"]
master_key_base64 = "ERERERERERERERERERERERERERERERERERERERERERE="
